// Game Asset Manifest - Comprehensive list of all game resources
// Used for initial preload into IndexedDB to enable offline gameplay

export interface AssetInfo {
    path: string;
    type: 'model' | 'texture' | 'audio' | 'hdr';
    priority: 'critical' | 'high' | 'medium' | 'low';
    estimatedSizeMB: number; // Estimated size in MB for progress tracking
    description: string;
}

