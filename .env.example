# Boby's World - Environment Variables Template
# This file defines all variables required for the application to function correctly.
# Copy this to .env, .env.local, or set them in your CI/CD (e.g., Vercel).

# --- CORE INFRASTRUCTURE ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.bobyworld.com

# --- SOLANA / BLOCKCHAIN ---
# Mainnet RPC (Public or Dedicated)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DEDICATED_RPC_ENDPOINT=https://your-dedicated-rpc-endpoint

# Wallet Addresses
NEXT_PUBLIC_ADMIN_WALLET_ADDRESS=your-solana-admin-wallet-address
NEXT_PUBLIC_STORE_TREASURY_WALLET_ADDRESS=your-treasury-wallet-address

# Ecosystem APIs
JUPITER_API_KEY=your-jupiter-api-key

# --- SECURITY & AUTHENTICATION ---
# JWT Secret Keys — Generate with: npm run generate-secrets
# Minimum 64 characters each in production (128 hex chars)
JWT_ACCESS_SECRET=GENERATE_WITH_npm_run_generate-secrets
JWT_REFRESH_SECRET=GENERATE_WITH_npm_run_generate-secrets

# Data Protection — 64 hex characters (32 bytes)
MASTER_ENCRYPTION_KEY=GENERATE_WITH_npm_run_generate-secrets

# Google reCAPTCHA
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# Admin & Cron Security
ADMIN_TOKEN=your-manual-admin-bypass-token
CRON_SECRET=your-secret-key-for-cron-jobs
ALLOWED_ADMIN_IPS=127.0.0.1,your-ip-address

# --- DATABASE (REDIS) ---
REDIS_URL=rediss://default:password@your-redis-instance.upstash.io:6379
REDIS_CLUSTER_MODE=false

# --- FIREBASE ---
# Web Config (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Admin SDK (Server-side)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- LOGGING & MONITORING ---
# Levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Slack Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# Audit Logging Security
LOG_ENCRYPTION_ENABLED=true
LOG_ENCRYPTION_KEY=your-aes-key-hex
LOG_TAMPER_DETECTION=true
LOG_SIGNING_SECRET=your-hmac-secret

# --- EMAIL (RESEND) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
FROM_EMAIL=auth@yourdomain.com

# --- CLOUD INFRASTRUCTURE (CDN/AWS) ---
CLOUDFLARE_ZONE_ID=your-zone-id
CLOUDFLARE_API_TOKEN=your-api-token
AWS_CLOUDFRONT_DISTRIBUTION_ID=your-dist-id
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# --- VERCEL SPECIFIC (Auto-populated by Vercel) ---
# NEXT_PUBLIC_VERCEL_ENV=production
# NEXT_PUBLIC_VERCEL_URL=your-project.vercel.app
