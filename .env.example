# Boby's World - Passkey System Environment Variables Template

# --- FIREBASE CONFIGURATION ---
# Create a project at https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# --- FIREBASE ADMIN SDK (Strictly Server-Side) ---
# Generate a new private key in Project Settings > Service Accounts
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- REDIS CONFIGURATION ---
# Used for WebAuthn challenges, sessions, and rate limiting
# You can use Upstash (https://upstash.com/) or a local instance
REDIS_URL=rediss://default:password@your-redis-instance.upstash.io:6379

# --- AUTHENTICATION SECRETS ---
# Generate strong random strings for these
JWT_ACCESS_SECRET=your-random-access-secret
JWT_REFRESH_SECRET=your-random-refresh-secret
MASTER_ENCRYPTION_KEY=your-32-byte-hex-key

# --- RECOVERY (RESEND) ---
# Create an account at https://resend.com/
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
FROM_EMAIL=auth@yourdomain.com

# --- ADMIN CONFIGURATION ---
NEXT_PUBLIC_ADMIN_WALLET_ADDRESS=your-solana-admin-wallet-address
ALLOWED_ADMIN_IPS=127.0.0.1,your-ip-address

# --- SECURITY (RECAPTCHA) ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-v2-checkbox-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# --- OTHER ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/Txxx/Bxxx/Xxxx
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# --- LOGGING CONFIGURATION ---
# Log Level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
# Encryption for sensitive logs
LOG_ENCRYPTION_ENABLED=true
LOG_ENCRYPTION_KEY=your-32-byte-hex-key-must-be-very-secure
# Tamper Detection
LOG_TAMPER_DETECTION=true
LOG_SIGNING_SECRET=your-secure-signing-secret
